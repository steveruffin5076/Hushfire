# Dependencies — installed per-machine by `npm ci`; committed copies carry
# another OS's native binaries (e.g. Windows rollup) and break fresh installs.
node_modules/

# Build output — GitHub Actions rebuilds this on every deploy.
dist/

# Accidental local bundles — never commit multi-MB archives.
*.tar.gz

# Local env / editor / OS noise
.env
.env.local
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite dev-server cache (local only).
vite.config.ts.timestamp-*.mjs
.tmp_anim_pack/
.tmp_anim_pack_v2/
.tmp_knife_attack/

# Blender pipeline — raw frame sequences (see art/ and AGENTS.md).
art/renders/
